{
  "name": "inhouse-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cms:types": "node --env-file=.env.local node_modules/payload/bin.js generate:types",
    "cms:importmap": "node --env-file=.env.local node_modules/payload/bin.js generate:importmap",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "audit:performance": "node scripts/performance.mjs",
    "test:cms": "node scripts/test-cms.mjs",
    "cms:migrate": "node --env-file=.env.local node_modules/payload/bin.js migrate",
    "cms:migration:create": "node --env-file=.env.local node_modules/payload/bin.js migrate:create",
    "preview:serve": "node scripts/preview-server.mjs",
    "preview:stop": "node scripts/preview-stop.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "graphql": "16.13.1",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "overrides": {
    "playwright-core": "1.58.2",
    "@payloadcms/next": {
      "sass": "1.106.0"
    },
    "dompurify": "3.4.17",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
