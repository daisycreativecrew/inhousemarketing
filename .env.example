PAYLOAD_SECRET=
DATABASE_URL=file:./.data/inhouse.db
SITE_URL=http://localhost:3000
# preview is visibly labelled and always noindex; live enforces approval gates.
SITE_MODE=preview
# Set true only after privacy policy and controller details have legal approval.
LEAD_CAPTURE_ENABLED=false
# Optional. HTTPS server-to-server adapter; never expose credentials to the browser.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
# Hosted checkout is disabled until price, terms and provider are configured.
START_CHECKOUT_URL=
BOOKING_URL=
# Optional same-origin consented event collector; see docs/integrations.md.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Production HTTPS only. Local HTTP previews leave this false.
COOKIE_SECURE=false
# Optional HTTPS email adapter, including password-reset delivery. Never logs mail contents.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM_ADDRESS=
# Set false when applying explicit migrations; no automatic destructive schema changes.
PAYLOAD_AUTO_PUSH=true
